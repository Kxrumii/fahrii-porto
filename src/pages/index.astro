---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext x='50' y='50' text-anchor='middle' dominant-baseline='central' font-size='80' font-family='monospace' font-weight='bold' fill='%2340a02b'%3EF%3C/text%3E%3C/svg%3E"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Fahrii | HOME</title>
		<ClientRouter />
	</head>

	<body class="bg-[#0a0a0a] text-[#f5f5f5] h-dvh overflow-hidden flex flex-col justify-between p-6 md:p-12 antialiased selection:bg-emerald-500 selection:text-black">

		<header class="flex justify-between items-start">
			<div class="flex flex-col gap-0.5">
				<span class="font-bold tracking-tighter text-xl md:text-2xl uppercase leading-none block">FAHRII</span>
				<span class="text-[10px] md:text-xs text-gray-600 tracking-widest uppercase leading-none block">Kxrumii</span>
			</div>
			<div class="text-right text-xs md:text-sm text-gray-400 font-mono flex flex-col gap-1 mt-1">
				<span class="leading-none block">Editor | Programmer</span>
				<span class="leading-none block">Computer Science Student</span>
			</div>
		</header>

		<main class="flex flex-col items-center justify-center w-full">
			<h1 class="text-[20vw] md:text-[16vw] font-black tracking-tighter leading-none uppercase select-none flex flex-col items-center">
				<span class="hover:text-emerald-400 transition-colors duration-700">Selected</span>
				<span class="-mt-4 md:-mt-12 hover:text-emerald-400 transition-colors duration-700 text-gray-300">Works<span class="text-emerald-500">.</span></span>
			</h1>
		</main>

		<footer class="flex justify-between items-end md:items-center relative w-full mb-2 md:mb-0">

			<div class="text-[10px] md:text-sm text-gray-500 font-mono whitespace-nowrap flex-shrink-0 pb-1.5 md:pb-0">
				© 2026 / ID-403
			</div>

			<div class="hidden md:block absolute left-1/2 -translate-x-1/2 bottom-0 w-1/3 text-center">
				<p class="text-[10px] text-gray-600/80 tracking-wider font-mono italic">
					"People can only save themselves.<br/>One person saving another is impossible."
				</p>
			</div>

			<div class="flex justify-end overflow-visible">
				<nav class="flex flex-col h-[32px] md:h-[48px] overflow-y-auto snap-y snap-mandatory text-right" style="scrollbar-width: none; -ms-overflow-style: none;">

					<a href="/profil/" class="whitespace-nowrap snap-start flex-shrink-0 h-[32px] md:h-[48px] group flex items-center justify-end gap-3 md:gap-4 text-2xl md:text-4xl font-light hover:text-emerald-400 transition-all duration-300">
						<span class="text-xs md:text-sm font-mono text-gray-600 group-hover:text-emerald-500 transition-colors">01</span>
						Profil Diri
						<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6 -rotate-45 group-hover:rotate-0 transition-transform duration-300 group-hover:-translate-x-1 group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
						</svg>
					</a>

					<a class="whitespace-nowrap snap-start flex-shrink-0 h-[32px] md:h-[48px] group flex items-center justify-end gap-3 md:gap-4 text-2xl md:text-4xl font-light hover:text-emerald-400 transition-all duration-300">
						<span class="text-xs md:text-sm font-mono text-gray-600 group-hover:text-emerald-500 transition-colors">02</span>
						Tugas Dua
						<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6 -rotate-45 group-hover:rotate-0 transition-transform duration-300 group-hover:-translate-x-1 group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
						</svg>
					</a>
				</nav>
			</div>
		</footer>

	</body>
</html>