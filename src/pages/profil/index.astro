                                <td class="py-4 px-2 font-bold">Pengembangan Aplikasi Mobile</td>
                                <td class="py-4 px-2">A</td>
                                <td class="py-4 px-2">3</td>
                                <td class="py-4 px-2">R.4.01</td>
                                <td class="py-4 px-2 font-mono text-[#5c5f77] dark:text-[#bac2de]">Kamis, 09:30 - 12:00</td>
                                <td class="py-4 px-2">H. Aldy Rialdy Atmadja M.T</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <footer id="contact" class="bg-[#dce0e8] dark:bg-[#11111b] min-h-[30vh] p-8 md:p-24 flex flex-col justify-center transition-colors duration-500">
            <div class="fade-in-up flex flex-col md:flex-row justify-between items-center md:items-end gap-8">
                <div class="text-center md:text-left">
                    <h2 class="text-3xl font-bold uppercase tracking-tighter mb-2">Socials.</h2>
                    <p class="text-[#5c5f77] dark:text-[#bac2de] text-sm font-mono max-w-sm">
                        Connect with me across the web.<br>Walau jarang aktif hehe.
                    </p>
                </div>

                <div class="flex flex-wrap justify-center gap-6">
                    <a href="https://github.com/kxrumii" aria-label="Kunjungi GitHub Fahri Khairun Ariansyah" target="_blank" class="hover:text-[#40a02b] dark:hover:text-[#a6e3a1] transition-colors group relative">
                        <span class="sr-only">GitHub</span>
                        <svg aria-hidden="true" class="w-6 h-6 md:w-8 md:h-8" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
                        <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-[10px] font-mono opacity-0 group-hover:opacity-100 transition-opacity">Kxrumii</span>
                    </a>

