---
import '../../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<!DOCTYPE html>
<html lang="id" id="html-root" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fahrii | Profil Diri</title>
    <meta name="description" content="Halaman profil diri mahasiswa Teknik Informatika, Fahri Khairun Ariansyah (Kxrumii).">
    
    <meta property="og:title" content="Fahrii | Profil Diri">
    <meta property="og:description" content="Halaman profil diri mahasiswa Teknik Informatika, Fahri Khairun Ariansyah.">
    <meta property="og:image" content="https://kxrumii.my.id/foto-diri.png">
    <meta property="og:type" content="website">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext x='50' y='50' text-anchor='middle' dominant-baseline='central' font-size='80' font-family='monospace' font-weight='bold' fill='%234c4f69'%3E1%3C/text%3E%3C/svg%3E" />
    <ClientRouter />

    <script is:inline>
        function applyTheme() {
            if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
    </script>
</head>

<body class="bg-[#eff1f5] text-[#4c4f69] dark:bg-[#1e1e2e] dark:text-[#cdd6f4] antialiased flex selection:bg-[#40a02b] selection:text-white dark:selection:bg-[#a6e3a1] transition-colors duration-500">

    <header id="side-nav" class="fixed left-0 inset-y-0 w-12 hover:w-56 border-r border-[#ccd0da] dark:border-[#313244] bg-[#eff1f5]/90 dark:bg-[#1e1e2e]/90 backdrop-blur z-50 transition-all duration-500 overflow-hidden group flex flex-col py-8">
        
        <div class="absolute right-0 top-0 w-[2px] h-full bg-[#ccd0da] dark:bg-[#313244]">
            <div id="progress-bar" class="w-full bg-[#40a02b] dark:bg-[#a6e3a1] h-0 transition-all duration-100 ease-out"></div>
        </div>

        <div class="flex flex-col h-full justify-between w-56">
            <div class="w-12 flex justify-center flex-shrink-0">
                <a href="/" aria-label="Kembali ke Halaman Beranda" class="block font-black text-lg tracking-tighter hover:text-[#40a02b] dark:hover:text-[#a6e3a1] transition-colors focus:outline-none focus:ring-2 focus:ring-[#40a02b] rounded-md">F.</a>
            </div>

            <nav aria-label="Navigasi Utama" class="flex flex-col gap-8">
                <a href="#perkenalan" aria-label="Lihat Perkenalan" class="flex items-center hover:text-[#40a02b] dark:hover:text-[#a6e3a1] transition-colors whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-[#40a02b] rounded-md group/item">
                    <div class="w-12 flex justify-center flex-shrink-0">
                        <span class="font-mono text-[10px] text-[#8c8fa1] dark:text-[#6c7086] pt-0.5 group-hover/item:text-[#40a02b] dark:group-hover/item:text-[#a6e3a1] transition-colors">01</span>
                    </div>
                    <span class="text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-75">Perkenalan</span>
                </a>
                <a href="#profil" aria-label="Lihat Profil Diri" class="flex items-center hover:text-[#40a02b] dark:hover:text-[#a6e3a1] transition-colors whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-[#40a02b] rounded-md group/item">
                    <div class="w-12 flex justify-center flex-shrink-0">
                        <span class="font-mono text-[10px] text-[#8c8fa1] dark:text-[#6c7086] pt-0.5 group-hover/item:text-[#40a02b] dark:group-hover/item:text-[#a6e3a1] transition-colors">02</span>
                    </div>
                    <span class="text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">Profil Diri</span>
                </a>
                <a href="#jadwal" aria-label="Lihat Jadwal Kuliah" class="flex items-center hover:text-[#40a02b] dark:hover:text-[#a6e3a1] transition-colors whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-[#40a02b] rounded-md group/item">
                    <div class="w-12 flex justify-center flex-shrink-0">
                        <span class="font-mono text-[10px] text-[#8c8fa1] dark:text-[#6c7086] pt-0.5 group-hover/item:text-[#40a02b] dark:group-hover/item:text-[#a6e3a1] transition-colors">03</span>
                    </div>
                    <span class="text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-150">Jadwal Kuliah</span>
                </a>
            </nav>

            <button id="theme-toggle" aria-label="Ubah Tema" class="flex items-center gap-4 hover:text-[#40a02b] dark:hover:text-[#a6e3a1] transition-colors cursor-pointer outline-none focus:outline-none focus:ring-2 focus:ring-[#40a02b] dark:focus:ring-[#a6e3a1] rounded">
                <span class="w-12 flex justify-center flex-shrink-0">
                    <svg aria-hidden="true" class="w-5 h-5 flex-shrink-0 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    <svg aria-hidden="true" class="w-5 h-5 flex-shrink-0 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                    </svg>
                </span>
            </button>
        </div>
    </header>

    <main class="ml-12 w-full min-h-[100svh] flex flex-col overflow-hidden relative">

        <div class="fixed right-10 top-10 font-mono text-xs text-[#ccd0da] dark:text-[#313244] pointer-events-none z-[-1]">+</div>
        <div class="fixed left-20 bottom-10 font-mono text-xs text-[#ccd0da] dark:text-[#313244] pointer-events-none z-[-1]">+</div>

        <section id="perkenalan" class="min-h-[100svh] flex items-center p-8 md:p-24 border-b border-[#ccd0da] dark:border-[#313244] relative overflow-hidden">
            <div class="absolute -right-10 md:-right-20 top-20 text-[25vw] font-black text-[#ccd0da]/30 dark:text-[#313244]/30 select-none leading-none pointer-events-none">01</div>
            
            <div class="max-w-4xl fade-in-up z-10 relative border-l-2 border-[#40a02b] dark:border-[#a6e3a1] pl-6 md:pl-10">
                <h3 class="text-[#40a02b] dark:text-[#a6e3a1] font-mono text-xs md:text-sm mb-4 tracking-widest uppercase">
                    // Hello, World.
                </h3>
                <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter leading-none mb-6">
                    Salam Kenal,<br/>Aku Fahri.
                </h1>
                <p class="text-lg md:text-xl text-[#5c5f77] dark:text-[#bac2de] max-w-2xl leading-relaxed">
                    Selamat datang di website profil diri sederhanaku. Ini adalah ruang buatku berekspresi, ngerjain tugas, sekaligus eksplorasi hal-hal baru di ranah pengembangan web.
                </p>
                <p class="font-mono text-[10px] text-[#8c8fa1] dark:text-[#6c7086] italic mt-6 select-none">
                    "People can only save themselves. One person saving another is impossible."
                </p>
            </div>
        </section>

        <section id="profil" class="min-h-[100svh] flex items-center p-8 md:p-24 border-b border-[#ccd0da] dark:border-[#313244] bg-[#e6e9ef] dark:bg-[#181825] transition-colors duration-500 relative overflow-hidden">
            <div class="absolute top-0 left-1/2 w-[1px] h-full bg-[#ccd0da] dark:bg-[#313244] pointer-events-none"></div>
            <div class="absolute md: top-20 text-[25vw] font-black text-[#ccd0da]/30 dark:text-[#313244]/30 select-none leading-none pointer-events-none">02</div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-center w-full max-w-6xl relative z-10">
                <div class="fade-in-up bg-[#e6e9ef] dark:bg-[#181825] md:pr-10">
                    <h2 class="text-4xl md:text-6xl font-bold uppercase tracking-tighter mb-2">FAHRI KHAIRUN<br/>ARIANSYAH.</h2>
                    <p class="font-mono text-xs text-[#8c8fa1] dark:text-[#6c7086] mb-8">— TEKNIK INFORMATIKA, UIN SGD</p>
                    
                    <p class="text-[#4c4f69] dark:text-[#cdd6f4] leading-relaxed mb-4 text-justify md:text-left">
                        Aku mahasiswa jurusan Teknik Informatika di UIN Sunan Gunung Djati Bandung. Selain nugas, aku suka banget ngoprek OS Linux (terutama ekosistem Arch dan Hyprland), bikin editan video/foto, sampai ngoding antarmuka web biar kelihatan minimalis dan enak dipandang.
                    </p>
                </div>
                
                <figure class="fade-in-up overflow-hidden bg-[#ccd0da] dark:bg-[#313244] aspect-square md:aspect-[4/5] shadow-2xl relative group border-4 border-white dark:border-[#11111b] rotate-2 hover:rotate-0 transition-transform duration-500">
                    <img src="/foto-diri.png" alt="Foto portrait Fahri Khairun Ariansyah mengenakan kemeja jurusan teknik informatika UIN Sunan Gunung Djati Bandung" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700" />
                    <figcaption class="absolute bottom-4 right-4 text-[10px] font-mono bg-black/50 text-white px-2 py-1 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                        IMG_01.DAT
                    </figcaption>
                </figure>
            </div>
        </section>

        <section id="jadwal" class="min-h-[100svh] flex flex-col justify-center p-8 md:p-24 border-b border-[#ccd0da] dark:border-[#313244] relative overflow-hidden">
            <div class="absolute -left-10 bottom-10 text-[20vw] font-black text-[#ccd0da]/30 dark:text-[#313244]/30 select-none leading-none pointer-events-none">03</div>

            <div class="w-full max-w-6xl fade-in-up z-10">
                <h2 class="text-4xl md:text-6xl font-bold uppercase tracking-tighter mb-8 md:mb-12 border-b-2 border-[#11111b] dark:border-[#cdd6f4] inline-block pb-2">
                    Jadwal Semester 5
                </h2>
                
                <div class="overflow-x-auto w-full pb-4">
                    <table class="w-full text-left border-collapse min-w-[800px]">
