                                <th scope="col" class="py-4 px-2">Kelas</th>
                                <th scope="col" class="py-4 px-2">SKS</th>
                                <th scope="col" class="py-4 px-2">Ruang</th>
                                <th scope="col" class="py-4 px-2">Waktu</th>
                                <th scope="col" class="py-4 px-2">Dosen</th>
                            </tr>
                        </thead>
                        <tbody class="text-sm" id="table-body">
                            <tr class="row-anim opacity-0 translate-y-4 border-b border-[#ccd0da]/50 dark:border-[#313244]/50 hover:bg-[#e6e9ef] dark:hover:bg-[#181825] transition-colors">
                                <td class="py-4 px-2 font-mono text-[#8c8fa1] dark:text-[#6c7086]">1</td>
                                <td class="py-4 px-2 font-bold">Manajemen Basis Data</td>
                                <td class="py-4 px-2">A</td>
                                <td class="py-4 px-2">3</td>
                                <td class="py-4 px-2">R.4.09</td>
                                <td class="py-4 px-2 font-mono text-[#5c5f77] dark:text-[#bac2de]">Senin, 09:30 - 12:00</td>
                                <td class="py-4 px-2">Wildan Budiawan Z. S.T., M.Kom.</td>
                            </tr>
                            <tr class="row-anim opacity-0 translate-y-4 border-b border-[#ccd0da]/50 dark:border-[#313244]/50 hover:bg-[#e6e9ef] dark:hover:bg-[#181825] transition-colors">
                                <td class="py-4 px-2 font-mono text-[#8c8fa1] dark:text-[#6c7086]">2</td>
                                <td class="py-4 px-2 font-bold">Manajemen Proyek Perangkat Lunak</td>
                                <td class="py-4 px-2">A</td>
                                <td class="py-4 px-2">3</td>
                                <td class="py-4 px-2">R.4.01</td>
                                <td class="py-4 px-2 font-mono text-[#5c5f77] dark:text-[#bac2de]">Senin, 07:00 - 09:30</td>
                                <td class="py-4 px-2">Agung Wahana S.E., M.T.</td>
                            </tr>
                            <tr class="row-anim opacity-0 translate-y-4 border-b border-[#ccd0da]/50 dark:border-[#313244]/50 hover:bg-[#e6e9ef] dark:hover:bg-[#181825] transition-colors">
                                <td class="py-4 px-2 font-mono text-[#8c8fa1] dark:text-[#6c7086]">3</td>
                                <td class="py-4 px-2 font-bold">Intelegensia Buatan</td>
                                <td class="py-4 px-2">A</td>
                                <td class="py-4 px-2">3</td>
                                <td class="py-4 px-2">R.4.10</td>
                                <td class="py-4 px-2 font-mono text-[#5c5f77] dark:text-[#bac2de]">Selasa, 15:30 - 18:00</td>
                                <td class="py-4 px-2">Jumadi ST., M.Cs.</td>
                            </tr>
                            <tr class="row-anim opacity-0 translate-y-4 border-b border-[#ccd0da]/50 dark:border-[#313244]/50 hover:bg-[#e6e9ef] dark:hover:bg-[#181825] transition-colors">
                                <td class="py-4 px-2 font-mono text-[#8c8fa1] dark:text-[#6c7086]">4</td>
                                <td class="py-4 px-2 font-bold">Sosio-Informatika & Profesionalisme</td>
                                <td class="py-4 px-2">D</td>
                                <td class="py-4 px-2">2</td>
                                <td class="py-4 px-2">R.4.10</td>
                                <td class="py-4 px-2 font-mono text-[#5c5f77] dark:text-[#bac2de]">Rabu, 12:40 - 14:20</td>
                                <td class="py-4 px-2">Dr. Yana Aditia G. ST., M.Kom.</td>
                            </tr>
                            <tr class="row-anim opacity-0 translate-y-4 border-b border-[#ccd0da]/50 dark:border-[#313244]/50 hover:bg-[#e6e9ef] dark:hover:bg-[#181825] transition-colors">
                                <td class="py-4 px-2 font-mono text-[#8c8fa1] dark:text-[#6c7086]">5</td>
                                <td class="py-4 px-2 font-bold">Jaringan Komputer</td>
                                <td class="py-4 px-2">A</td>
                                <td class="py-4 px-2">3</td>
                                <td class="py-4 px-2">R.4.11</td>
                                <td class="py-4 px-2 font-mono text-[#5c5f77] dark:text-[#bac2de]">Rabu, 09:30 - 12:00</td>
                                <td class="py-4 px-2">Cecep Nurul Alam M.T.</td>
                            </tr>
                            <tr class="row-anim opacity-0 translate-y-4 border-b border-[#ccd0da]/50 dark:border-[#313244]/50 hover:bg-[#e6e9ef] dark:hover:bg-[#181825] transition-colors">
                                <td class="py-4 px-2 font-mono text-[#8c8fa1] dark:text-[#6c7086]">6</td>
                                <td class="py-4 px-2 font-bold">Interaksi Manusia & Komputer</td>
                                <td class="py-4 px-2">A</td>
                                <td class="py-4 px-2">3</td>
                                <td class="py-4 px-2">R.4.01</td>
                                <td class="py-4 px-2 font-mono text-[#5c5f77] dark:text-[#bac2de]">Rabu, 07:00 - 09:30</td>
                                <td class="py-4 px-2">Dr. Cepy Slamet S.T., M.Kom.</td>
                            </tr>
                            <tr class="row-anim opacity-0 translate-y-4 border-b border-[#ccd0da]/50 dark:border-[#313244]/50 hover:bg-[#e6e9ef] dark:hover:bg-[#181825] transition-colors">
                                <td class="py-4 px-2 font-mono text-[#8c8fa1] dark:text-[#6c7086]">7</td>
                                <td class="py-4 px-2 font-bold">Pengembangan Aplikasi Web</td>
                                <td class="py-4 px-2">A</td>
                                <td class="py-4 px-2">3</td>
                                <td class="py-4 px-2">R.4.01</td>
                                <td class="py-4 px-2 font-mono text-[#5c5f77] dark:text-[#bac2de]">Kamis, 15:30 - 18:00</td>
